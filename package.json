{
  "name": "tidebreak",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Tidebreak: The Drowned Frontier — a 404 recipe water combat racer",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "python3 -m http.server 4173 --bind 127.0.0.1 --directory game",
    "test": "node --test tests/campaign.test.mjs tests/combat.test.mjs tests/race-rules.test.mjs",
    "check": "node tools/compliance-check.mjs --selftest && node ../404-game-recipe/harness/ship.mjs game",
    "verify:assets": "node ../404-game-recipe/harness/verify.mjs game/assets --size=560"
  }
}
